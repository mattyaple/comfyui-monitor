{
 "project": {
  "name": "My Project",
  "code": "PROJ",
  "title": "PROJ Run Monitor",
  "client": ""
 },
 "terms": {
  "unit": "shot",
  "units": "shots"
 },
 "server": {
  "port": 8765,
  "poll_ms": 2500
 },
 "paths": {
  "output_root": "~/ComfyUI/output/{code}",
  "output_prefix": "{code}/",
  "comfy_input": "~/ComfyUI/input",
  "comfy_bin": "~/.local/share/uv/tools/comfy-mcp/bin/comfy",
  "runs": "{monitor}/runs",
  "workflows": "{project}/workflows",
  "exports": "{project}/exports",
  "selects_root": "",
  "moved_lookup": []
 },
 "versions": {
  "enabled": false,
  "current": "V1",
  "first": 1,
  "folder": "V{n}",
  "staging": "V{n}_Staging",
  "file_suffix": "_v{n}",
  "refuse_frozen": true
 },
 "collections": [
  {
   "id": "shots",
   "label": "Shots",
   "kind": "shots",
   "dir": "{version}",
   "group_regex": "^[A-Za-z0-9][^/]*$",
   "color": "#ffcf33",
   "file_name": "{group}{file_suffix}_{n:03d}",
   "sections": [
    {
     "id": "option",
     "label": "Options",
     "sub": "",
     "color": "#ffcf33"
    },
    {
     "id": "edit",
     "label": "Edits",
     "sub": "_edits",
     "color": "#c792ea",
     "compare": "source"
    },
    {
     "id": "plate",
     "label": "Plates",
     "sub": "_plates",
     "color": "#7fd7c4",
     "compare": "hash"
    }
   ],
   "select": {
    "mode": "tag",
    "dest": "{selects_root}/{version}/{group}",
    "section_dest": {},
    "unselect": "z_old"
   }
  },
  {
   "id": "refs",
   "label": "References",
   "kind": "folders",
   "dir": "References",
   "depth": 2,
   "color": "#3ddc84",
   "section_from_name": "_ref_(.+)$",
   "section_order": [
    "design",
    "face",
    "body",
    "turn",
    "expr"
   ],
   "select": {
    "mode": "copy",
    "dest": "{project}/references/{group}",
    "dest_map": {},
    "unselect": "z_old"
   }
  },
  {
   "id": "tests",
   "label": "Testing",
   "kind": "folders",
   "dir": "__TESTING",
   "depth": 0,
   "color": "#8b95a3",
   "select": {
    "mode": "tag"
   }
  }
 ],
 "runs": {
  "extra_categories": [],
  "ref_roles": [
   [
    "_mask$",
    "mask"
   ],
   [
    "^plate_|lineart|sketch|matte|layout|graybox|schematic",
    "plate"
   ],
   [
    "facegrid",
    "face grid"
   ],
   [
    "(^|_)face",
    "face"
   ],
   [
    "turnaround|_turn(_|$)",
    "turnaround"
   ],
   [
    "expression|_expr",
    "expressions"
   ],
   [
    "(^|_)body|_hero|lineup",
    "body"
   ],
   [
    "sheet",
    "sheet"
   ],
   [
    "angles?_grid",
    "angle grid"
   ],
   [
    "^env_",
    "environment"
   ],
   [
    "style",
    "style"
   ],
   [
    "logo",
    "logo"
   ],
   [
    "photo",
    "photo"
   ],
   [
    "_SEL$",
    "select"
   ],
   [
    "product|packshot|bottle",
    "product"
   ]
  ],
  "collapse_after": 2
 },
 "selects": {
  "tags": {
   "select": "Yellow",
   "ng": "Red"
  }
 },
 "export": {
  "enabled": true,
  "footer": "{client} \u00b7 {title} \u00b7 {date}",
  "default_template": "contact",
  "templates": {
   "contact": {
    "enabled": true,
    "label": "Contact sheet",
    "format": "jpg",
    "columns": 4,
    "thumb": 900,
    "captions": true,
    "group_headers": true,
    "paper": "letter",
    "orientation": "landscape"
   },
   "review": {
    "enabled": true,
    "label": "Review PDF",
    "format": "pdf",
    "per_row": 2,
    "captions": true,
    "prompt": false,
    "notes": true,
    "cover": true,
    "paper": "letter",
    "orientation": "landscape"
   }
  }
 },
 "costs": {
  "enabled": true,
  "client": "",
  "project": "",
  "credit_log": "~/AI_Credit_Log/ai_credit_log.csv",
  "credits_per_usd": 211,
  "budget_usd": null,
  "bill_runs": true,
  "balance_cache_s": 120,
  "person": "",
  "shared_dir": ""
 },
 "naming": {
  "strip_trailing_underscore": true
 },
 "engines": {
  "api_nodes_extra": [],
  "generator_nodes_extra": []
 }
}
